<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    IdentityUser lives in Microsoft.Extensions.Identity.Stores, which ships inside the
    ASP.NET Core shared framework. A FrameworkReference is not a NuGet package, so the Domain
    project still has zero package dependencies.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
