@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <div class="auth-panel">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="margin-bottom:var(--sp-10)">
            <div class="navbar-brand-mark">P</div>PersonaNest
        </a>

        <h1 style="font-family:var(--font-display);font-size:30px;font-weight:600;margin-bottom:var(--sp-2)">
            Choose a new password.
        </h1>
        <p style="color:var(--text-secondary);margin-bottom:var(--sp-8)">
            @Model.Form.Email
        </p>

        <form asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
            <input type="hidden" asp-for="Form.Email" />
            <input type="hidden" asp-for="Form.Token" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.NewPassword"></label>
                <input class="form-input" asp-for="Form.NewPassword" autocomplete="new-password" />
                <span asp-validation-for="Form.NewPassword"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.ConfirmPassword"></label>
                <input class="form-input" asp-for="Form.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Form.ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width:100%">Reset password</button>
        </form>

        <p style="margin-top:var(--sp-6);color:var(--text-secondary);font-size:14px">
            <a asp-controller="Auth" asp-action="Login" style="color:var(--primary)">Back to log in</a>
        </p>
    </div>

    <aside class="auth-visual" aria-hidden="true">
        <div>
            <p class="auth-visual-quote">
                &ldquo;Chasing the feeling of the first time, every time.&rdquo;
            </p>
            <div class="auth-visual-attrib">PersonaNest</div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
