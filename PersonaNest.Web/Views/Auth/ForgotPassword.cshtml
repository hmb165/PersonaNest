@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <div class="auth-panel">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="margin-bottom:var(--sp-10)">
            <div class="navbar-brand-mark">P</div>PersonaNest
        </a>

        <h1 style="font-family:var(--font-display);font-size:30px;font-weight:600;margin-bottom:var(--sp-2)">
            Reset your password.
        </h1>

        @if (Model.EmailSent)
        {
            <p style="color:var(--text-secondary);margin-bottom:var(--sp-8)">
                If an account exists for that address, we've sent a reset link. In development,
                the link is written to the application log instead of a real inbox.
            </p>
        }
        else
        {
            <p style="color:var(--text-secondary);margin-bottom:var(--sp-8)">
                Enter the email address on your account and we'll send you a link to reset your password.
            </p>

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-group">
                    <label class="form-label" asp-for="Form.Email"></label>
                    <input class="form-input" asp-for="Form.Email" autocomplete="email" />
                    <span asp-validation-for="Form.Email"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg" style="width:100%">Send reset link</button>
            </form>
        }

        <p style="margin-top:var(--sp-6);color:var(--text-secondary);font-size:14px">
            <a asp-controller="Auth" asp-action="Login" style="color:var(--primary)">Back to log in</a>
        </p>
    </div>

    <aside class="auth-visual" aria-hidden="true">
        <div>
            <p class="auth-visual-quote">
                &ldquo;Chasing the feeling of the first time, every time.&rdquo;
            </p>
            <div class="auth-visual-attrib">PersonaNest</div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
