@model RegisterViewModel
@{
    ViewData["Title"] = "Join";
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <div class="auth-panel">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="margin-bottom:var(--sp-10)">
            <div class="navbar-brand-mark">P</div>PersonaNest
        </a>

        <h1 style="font-family:var(--font-display);font-size:30px;font-weight:600;margin-bottom:var(--sp-2)">
            Make it yours.
        </h1>
        <p style="color:var(--text-secondary);margin-bottom:var(--sp-8)">
            Build a profile around everything you love.
        </p>

        <form asp-controller="Auth" asp-action="Register" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.DisplayName"></label>
                <input class="form-input" asp-for="Form.DisplayName" autocomplete="name" />
                <span asp-validation-for="Form.DisplayName"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.UserName"></label>
                <input class="form-input" asp-for="Form.UserName" autocomplete="username" />
                <div class="form-hint">Letters, digits and underscores. This becomes your profile URL.</div>
                <span asp-validation-for="Form.UserName"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.Email"></label>
                <input class="form-input" asp-for="Form.Email" autocomplete="email" />
                <span asp-validation-for="Form.Email"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.Password"></label>
                <input class="form-input" asp-for="Form.Password" autocomplete="new-password" />
                <div class="form-hint">
                    At least 8 characters, with an upper case letter, a lower case letter and a digit.
                </div>
                <span asp-validation-for="Form.Password"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Form.ConfirmPassword"></label>
                <input class="form-input" asp-for="Form.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Form.ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width:100%">Create account</button>
        </form>

        <p style="margin-top:var(--sp-6);color:var(--text-secondary);font-size:14px">
            Already have an account?
            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl"
               style="color:var(--primary)">Log in</a>
        </p>
    </div>

    <aside class="auth-visual" aria-hidden="true">
        <div>
            <p class="auth-visual-quote">
                &ldquo;Track games, movies, anime, books, and more.&rdquo;
            </p>
            <div class="auth-visual-attrib">PersonaNest</div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
