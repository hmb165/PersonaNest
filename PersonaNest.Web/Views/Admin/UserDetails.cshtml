@model UserCardDto
@{
    ViewData["Title"] = $"Manage {Model.UserName}";
    ViewData["Nav"] = "Admin";
    var isAdmin = Model.Roles.Contains("Admin");
    var isModerator = Model.Roles.Contains("Moderator");
}

<div style="max-width:640px;margin:0 auto;padding:var(--sp-8)">
    <div class="card" style="padding:var(--sp-6)">
        <div class="flex gap-4" style="margin-bottom:var(--sp-5)">
            <div class="avatar" style="width:64px;height:64px">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="@Model.DisplayName" />
                }
                else
                {
                    <span class="avatar-fallback" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px">
                        @Model.DisplayName.FirstOrDefault()
                    </span>
                }
            </div>
            <div>
                <div style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--text-primary)">
                    @Model.DisplayName
                </div>
                <div class="mono" style="font-size:13px;color:var(--text-muted)">&#64;@Model.UserName &middot; @Model.Email</div>
                <div style="margin-top:6px">
                    <span class="badge @(isAdmin ? "badge-role-admin" : isModerator ? "badge-role-mod" : "badge-role-user")">
                        @(isAdmin ? "Admin" : isModerator ? "Moderator" : "User")
                    </span>
                    @if (Model.IsBanned)
                    {
                        <span class="badge badge-danger">Banned</span>
                    }
                </div>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);margin-bottom:var(--sp-6)">
            <div>
                <div class="stat-card-label">Entries</div>
                <div class="stat-card-value" style="font-size:22px">@Model.EntryCount</div>
            </div>
            <div>
                <div class="stat-card-label">Joined</div>
                <div class="stat-card-value" style="font-size:22px">@Model.CreatedAt.ToString("MMM yyyy")</div>
            </div>
        </div>

        @if (Model.IsBanned && !string.IsNullOrWhiteSpace(Model.BanReason))
        {
            <div class="alert alert-danger" style="margin-bottom:var(--sp-5)">
                <span class="alert-icon">&#9888;</span>
                <div class="alert-body"><strong>Ban reason:</strong> @Model.BanReason</div>
            </div>
        }

        <a class="btn btn-ghost btn-sm" asp-controller="Profile" asp-action="Index"
           asp-route-userName="@Model.UserName" style="margin-bottom:var(--sp-5);display:inline-block">
            View public profile &rarr;
        </a>

        <div class="divider"></div>

        <div style="display:flex;flex-direction:column;gap:var(--sp-4);margin-top:var(--sp-5)">
            @if (!isAdmin)
            {
                <div class="flex gap-2">
                    @if (isModerator)
                    {
                        <form asp-controller="Admin" asp-action="Demote" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-secondary btn-sm">Demote to User</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Admin" asp-action="Promote" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-secondary btn-sm"
                                    style="background:rgba(251,191,36,0.12);color:var(--warning);border:1px solid rgba(251,191,36,0.3)">
                                Promote to Moderator
                            </button>
                        </form>
                    }
                </div>

                @if (Model.IsBanned)
                {
                    <form asp-controller="Admin" asp-action="Unban" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-secondary btn-sm">Unban Account</button>
                    </form>
                }
                else
                {
                    <form asp-controller="Admin" asp-action="Ban" asp-route-id="@Model.Id" method="post"
                          class="flex gap-2" onsubmit="return confirm('Ban @Model.UserName? They will be unable to sign in.');">
                        <input class="form-input" type="text" name="reason" placeholder="Reason for ban" required
                               style="flex:1" />
                        <button type="submit" class="btn btn-danger btn-sm">Ban Account</button>
                    </form>
                }
            }
            else
            {
                <p class="text-muted" style="font-size:13px">Administrators cannot be demoted or banned from here.</p>
            }
        </div>
    </div>
</div>
