@model SearchViewModel
@{
    ViewData["Title"] = "Media Management";
    ViewData["Nav"] = "Admin";
}

<div style="padding:var(--sp-6) var(--sp-8)">
    <a class="settings-back" style="margin:0 0 var(--sp-4) 0" asp-controller="Admin" asp-action="Index">&#8592; Back to admin</a>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-5);flex-wrap:wrap;gap:var(--sp-3)">
        <div style="font-family:var(--font-display);font-size:24px;font-weight:600;color:var(--text-primary)">
            Media Management <span style="font-size:16px;color:var(--text-muted);font-family:var(--font-mono)">(@Model.TotalCount)</span>
        </div>
        <form asp-controller="Admin" asp-action="Media" method="get" class="flex gap-2">
            <input class="form-input" type="text" name="Query" value="@Model.Filter.Query"
                   placeholder="Search title or creator…" style="width:240px" />
            <button type="submit" class="btn btn-secondary btn-sm">Search</button>
        </form>
    </div>

    @if (!Model.HasResults)
    {
        <div class="empty-state">
            <div class="empty-state-title">No media found</div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Media</th><th>Category</th><th>Entries</th><th>Avg Rating</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var media in Model.Results)
                    {
                        <tr>
                            <td>
                                <div class="flex gap-3">
                                    <div style="width:36px;height:52px;border-radius:var(--r-sm);overflow:hidden;background:var(--bg-overlay);flex-shrink:0">
                                        @if (!string.IsNullOrEmpty(media.OfficialCoverUrl))
                                        {
                                            <img src="@media.OfficialCoverUrl" alt="@media.Title" style="width:100%;height:100%;object-fit:cover" />
                                        }
                                    </div>
                                    <a asp-controller="Media" asp-action="Details" asp-route-id="@media.Id" style="color:var(--primary)">
                                        <strong>@media.Title</strong>
                                    </a>
                                </div>
                            </td>
                            <td><span class="badge badge-primary" style="font-size:10px">@media.CategoryName</span></td>
                            <td class="mono">@media.EntryCount</td>
                            <td>
                                @if (media.AverageRating is not null)
                                {
                                    <span style="color:var(--warning);font-family:var(--font-mono)">&#9733; @media.AverageRating.Value.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                <div class="flex gap-2">
                                    <a class="btn btn-ghost btn-sm" asp-controller="Media" asp-action="Edit" asp-route-id="@media.Id">Edit</a>
                                    <form asp-controller="Admin" asp-action="MediaDelete" asp-route-id="@media.Id" method="post"
                                          onsubmit="return confirm('Remove \'@media.Title\'? Existing entries keep their data but the item leaves search and browsing (§9 - soft delete, never hard).');">
                                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="flex gap-2" style="justify-content:center;margin-top:var(--sp-6)">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="Media"
                       asp-route-Query="@Model.Filter.Query" asp-route-Page="@(Model.Page - 1)">&larr; Previous</a>
                }
                <span class="mono" style="align-self:center;color:var(--text-muted);font-size:13px">
                    Page @Model.Page of @Model.TotalPages
                </span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="Media"
                       asp-route-Query="@Model.Filter.Query" asp-route-Page="@(Model.Page + 1)">Next &rarr;</a>
                }
            </div>
        }
    }
</div>
