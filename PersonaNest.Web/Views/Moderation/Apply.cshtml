@model ModeratorApplicationViewModel
@{
    ViewData["Title"] = "Apply to Moderate";
}

<div style="max-width:560px;margin:0 auto;padding:var(--sp-10)">
    <div style="font-family:var(--font-display);font-size:28px;font-weight:600;color:var(--text-primary);margin-bottom:var(--sp-2)">
        Apply to Moderate
    </div>
    <div style="font-size:14px;color:var(--text-secondary);margin-bottom:var(--sp-8);line-height:1.6">
        Help keep PersonaNest a welcoming and accurate community. Moderators can flag content, review
        media submissions, and support users.
    </div>

    @if (Model.ExistingApplication is { Status: ApplicationStatus.Pending })
    {
        <div class="alert alert-info">
            <span class="alert-icon">&#8505;</span>
            <div class="alert-body">
                <div class="alert-title">Your application is under review.</div>
                Submitted @Model.ExistingApplication.AppliedAt.ToString("d MMM yyyy"). An admin will
                get back to you.
            </div>
        </div>
    }
    else
    {
        @if (Model.ExistingApplication is { Status: ApplicationStatus.Rejected })
        {
            <div class="alert alert-warning" style="margin-bottom:var(--sp-6)">
                <span class="alert-icon">&#9888;</span>
                <div class="alert-body">
                    Your previous application was not approved. You're welcome to apply again.
                </div>
            </div>
        }

        <div class="alert alert-info" style="margin-bottom:var(--sp-6)">
            <span class="alert-icon">&#8505;</span>
            <div class="alert-body">Your current profile and activity will be visible to the reviewing admin.</div>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <section class="settings-section">
            <div class="settings-section-title">Your Application</div>
            <form asp-controller="Moderation" asp-action="Apply" method="post" novalidate>
                <div class="form-group">
                    <label class="form-label" asp-for="Form.Reason"></label>
                    <textarea class="form-textarea" asp-for="Form.Reason" style="min-height:140px"
                              placeholder="Tell us about your experience with the community and why you'd be a good fit…"></textarea>
                    <span asp-validation-for="Form.Reason"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Form.RelevantExperience"></label>
                    <textarea class="form-textarea" asp-for="Form.RelevantExperience" style="min-height:80px"
                              placeholder="Previous moderation roles, community management, etc."></textarea>
                    <span asp-validation-for="Form.RelevantExperience"></span>
                </div>
                <button type="submit" class="btn btn-primary">Submit Application</button>
            </form>
        </section>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
