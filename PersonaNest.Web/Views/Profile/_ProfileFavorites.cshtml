@model IReadOnlyList<MediaCardDto>

<h2 class="dashboard-section-title">Favorites</h2>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-title">No favourites yet</div>
        <p>Favouriting media arrives in Phase 8.</p>
    </div>
}
else
{
    <div class="profile-favorites">
        @foreach (var media in Model)
        {
            <div class="profile-fav-slot" title="@media.Title">
                @if (!string.IsNullOrEmpty(media.OfficialCoverUrl))
                {
                    <img src="@media.OfficialCoverUrl" alt="@media.Title" />
                }
            </div>
        }
    </div>
}
