@model ProfileViewModel
@{
    ViewData["Title"] = Model.Header.DisplayName;
    var tab = Model.ActiveTab;
}

@*
    Two independent per-user custom properties, cascading only inside this profile: --profile-bg
    (from the selected Theme) tints the page background alone, and --profile-text-accent (from the
    custom accent colour) tints a handful of text highlights alone. Neither touches the other, and
    neither touches the banner or buttons - those stay on the site-wide default --primary.
*@
<div class="profile-container page-shell"
     style="--profile-bg: @Model.Header.BackgroundColor; --profile-text-accent: @Model.Header.AccentColor;">

    <div class="profile-banner">
        @if (!string.IsNullOrEmpty(Model.Header.BannerUrl))
        {
            <img src="@Model.Header.BannerUrl" alt="" />
        }
        <div class="profile-banner-overlay"></div>
        @if (Model.Header.IsViewerSelf)
        {
            <div class="profile-banner-actions">
                <a class="icon-btn" asp-controller="Profile" asp-action="Edit"
                   title="Edit profile" aria-label="Edit profile">&#9998;</a>
                <a class="icon-btn" asp-controller="Settings" asp-action="Index"
                   title="Settings" aria-label="Settings">&#9881;</a>
            </div>
        }
    </div>

    <header class="profile-header">
        <div class="profile-avatar">
            @if (!string.IsNullOrEmpty(Model.Header.ProfilePictureUrl))
            {
                <img src="@Model.Header.ProfilePictureUrl" alt="@Model.Header.DisplayName" />
            }
            else
            {
                <span class="avatar-fallback">@Model.Header.DisplayName.FirstOrDefault()</span>
            }
        </div>

        <div class="profile-info">
            <h1 class="profile-username">@Model.Header.DisplayName</h1>
            <div class="profile-handle">&#64;@Model.Header.UserName</div>
            @if (!string.IsNullOrWhiteSpace(Model.Header.Bio))
            {
                <p class="profile-bio">@Model.Header.Bio</p>
            }
        </div>

        <div class="profile-actions">
            @if (!Model.Header.IsViewerSelf)
            {
                @if (User.IsSignedIn())
                {
                    <form asp-controller="Social" asp-action="Follow" asp-route-id="@Model.Header.Id" method="post">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="btn @(Model.Header.IsFollowedByViewer ? "btn-secondary" : "btn-primary")">
                            @(Model.Header.IsFollowedByViewer ? "Following ✓" : "Follow")
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Follow</a>
                }
            }
        </div>
    </header>

    <div class="profile-stats">
        <div class="profile-stat">
            <div class="profile-stat-val">@Model.Stats.EntryCount</div>
            <div class="profile-stat-label">Entries</div>
        </div>
        <a class="profile-stat" style="text-decoration:none;color:inherit" asp-controller="Social" asp-action="Following"
           asp-route-userName="@Model.Header.UserName">
            <div class="profile-stat-val">@Model.Stats.FollowingCount</div>
            <div class="profile-stat-label">Following</div>
        </a>
        <a class="profile-stat" style="text-decoration:none;color:inherit" asp-controller="Social" asp-action="Followers"
           asp-route-userName="@Model.Header.UserName">
            <div class="profile-stat-val">@Model.Stats.FollowerCount</div>
            <div class="profile-stat-label">Followers</div>
        </a>
        <div class="profile-stat">
            <div class="profile-stat-val">@Model.Stats.CollectionCount</div>
            <div class="profile-stat-label">Collections</div>
        </div>
        <div class="profile-stat">
            <div class="profile-stat-val" style="color:var(--warning)">
                @(Model.Stats.AverageRating?.ToString("0.0") ?? "&mdash;")
            </div>
            <div class="profile-stat-label">Avg Rating</div>
        </div>
    </div>

    <nav class="profile-tabs">
        @foreach (var name in new[] { "Entries", "Collections", "Favorites", "Taste Profile" })
        {
            <a class="profile-tab @(tab == name ? "active" : null)"
               asp-action="Index" asp-route-userName="@Model.Header.UserName" asp-route-tab="@name">@name</a>
        }
    </nav>

    <div class="profile-body">
        <div class="profile-grid">
            <div>
                @switch (tab)
                {
                    case "Collections":
                        <partial name="_ProfileCollections" model="Model.Collections" />
                        break;
                    case "Favorites":
                        <partial name="_ProfileFavorites" model="Model.Favorites" />
                        break;
                    case "Taste Profile":
                        <partial name="_TasteProfile" model="Model.TasteProfile" />
                        break;
                    default:
                        <partial name="_ProfileEntries" model="Model.RecentEntries" />
                        break;
                }
            </div>

            <aside>
                <div class="card" style="padding:var(--sp-5);margin-bottom:var(--sp-4)">
                    <div class="dashboard-section-title">Taste Profile</div>
                    <partial name="_TasteProfile" model="Model.TasteProfile" />
                </div>

                <div class="card" style="padding:var(--sp-5)">
                    <div class="dashboard-section-title">Stats</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4)">
                        <div>
                            <div class="stat-card-value" style="color:var(--profile-text-accent)">@Model.Stats.EntryCount</div>
                            <div class="stat-card-label">Total Entries</div>
                        </div>
                        <div>
                            <div class="stat-card-value" style="color:var(--warning)">
                                @(Model.Stats.AverageRating?.ToString("0.0") ?? "&mdash;")
                            </div>
                            <div class="stat-card-label">Avg Rating</div>
                        </div>
                        <div>
                            <div class="stat-card-value" style="color:var(--success)">@Model.Stats.CollectionCount</div>
                            <div class="stat-card-label">Collections</div>
                        </div>
                        <div>
                            <div class="stat-card-value" style="color:var(--accent)">@Model.Stats.ReviewCount</div>
                            <div class="stat-card-label">Reviews</div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>
