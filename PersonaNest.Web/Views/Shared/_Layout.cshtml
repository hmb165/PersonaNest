@using Microsoft.AspNetCore.Identity
@using PersonaNest.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PersonaNest</title>
    <meta name="description" content="Your home for everything you love." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@@9..144,300;9..144,400;9..144,600;9..144,700&amp;family=Outfit:wght@@300;400;500;600;700&amp;family=JetBrains+Mono:wght@@400;500&amp;display=swap" rel="stylesheet" />

    @* Bootstrap 5 first, then site.css overrides it - design system "Bootstrap 5 + Custom CSS Strategy". *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="navbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <div class="navbar-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20">
                    <g stroke="#fff" stroke-width="1.5" stroke-linecap="round" fill="none">
                        <path d="M2 17c3-2 6-3 10-3s7 1 10 3" />
                        <path d="M4 14.5c2.5-1.5 5-2.2 8-2.2s5.5 0.7 8 2.2" />
                        <path d="M6.5 12.3c1.8-1 3.7-1.5 5.5-1.5s3.7 0.5 5.5 1.5" />
                    </g>
                    <circle cx="10" cy="9" r="1.6" fill="#fff" />
                    <circle cx="13.2" cy="8.3" r="1.3" fill="#fff" opacity="0.85" />
                </svg>
            </div>PersonaNest
        </a>

        <div class="navbar-center d-none d-lg-flex">
            <a class="navbar-link @(ViewData["Nav"] as string == "Home" ? "active" : null)"
               asp-controller="Home" asp-action="Index">Home</a>
            <a class="navbar-link @(ViewData["Nav"] as string == "Search" ? "active" : null)"
               asp-controller="Search" asp-action="Index">Search</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="navbar-link @(ViewData["Nav"] as string == "Dashboard" ? "active" : null)"
                   asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            }
            @if (User.IsInRole(Roles.Moderator) || User.IsInRole(Roles.Admin))
            {
                <a class="navbar-link @(ViewData["Nav"] as string == "Moderation" ? "active" : null)"
                   asp-controller="Moderation" asp-action="Dashboard">Mod Panel</a>
            }
            @if (User.IsInRole(Roles.Admin))
            {
                <a class="navbar-link @(ViewData["Nav"] as string == "Admin" ? "active" : null)"
                   asp-controller="Admin" asp-action="Index">Admin</a>
            }
        </div>

        <div class="navbar-right">
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-ghost btn-sm d-none d-md-inline-flex"
                   asp-controller="Entries" asp-action="Index">My Entries</a>
                <a class="btn btn-ghost btn-sm d-none d-lg-inline-flex"
                   asp-controller="Favorites" asp-action="Index">Favorites</a>
                <a class="btn btn-ghost btn-sm d-none d-lg-inline-flex"
                   asp-controller="Collections" asp-action="Index">Collections</a>

                @* Phase 15: real-time notification bell. Always visible - unlike the text links
                   above it's compact enough to survive every breakpoint without collapsing into
                   the hamburger panel. *@
                @await Component.InvokeAsync("NotificationBell")

                <a class="navbar-avatar d-none d-sm-inline-block" asp-controller="Profile" asp-action="Index"
                   asp-route-userName="@User.Identity!.Name" title="@User.Identity!.Name">
                    @{
                        var currentUser = await UserManager.GetUserAsync(User);
                    }
                    @if (!string.IsNullOrEmpty(currentUser?.ProfilePictureUrl))
                    {
                        <img src="@currentUser.ProfilePictureUrl" alt="Your avatar" />
                    }
                    else
                    {
                        <span class="avatar-fallback">@(currentUser?.DisplayName?.FirstOrDefault() ?? 'U')</span>
                    }
                </a>
            }
            else
            {
                <a class="btn btn-ghost btn-sm" asp-controller="Auth" asp-action="Login">Sign in</a>
                <a class="btn btn-primary btn-sm d-none d-sm-inline-flex" asp-controller="Auth" asp-action="Register">Sign up</a>
            }

            @* Hamburger navbar (design system Responsive Breakpoints, <lg) - the links above
               collapse via "d-none d-lg-flex"/"d-none d-md-inline-flex" etc. with no other way to
               reach them below that width without this. Uses Bootstrap's own bundled Collapse
               plugin - no new script, no custom JS. *@
            <button class="navbar-toggler d-lg-none" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mobileNav"
                    aria-controls="mobileNav" aria-expanded="false" aria-label="Toggle navigation">
                <span aria-hidden="true">&#9776;</span>
            </button>
        </div>
    </nav>

    <div class="collapse d-lg-none" id="mobileNav">
        <div class="mobile-nav-panel">
            <a class="navbar-link" data-bs-toggle="collapse" data-bs-target="#mobileNav"
               asp-controller="Home" asp-action="Index">Home</a>
            <a class="navbar-link" data-bs-toggle="collapse" data-bs-target="#mobileNav"
               asp-controller="Search" asp-action="Index">Search</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="navbar-link" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            }
            @if (User.IsInRole(Roles.Moderator) || User.IsInRole(Roles.Admin))
            {
                <a class="navbar-link" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Moderation" asp-action="Dashboard">Mod Panel</a>
            }
            @if (User.IsInRole(Roles.Admin))
            {
                <a class="navbar-link" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Admin" asp-action="Index">Admin</a>
            }

            @if (SignInManager.IsSignedIn(User))
            {
                <hr />
                <a class="btn btn-ghost" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Entries" asp-action="Index">My Entries</a>
                <a class="btn btn-ghost" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Favorites" asp-action="Index">Favorites</a>
                <a class="btn btn-ghost" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Collections" asp-action="Index">Collections</a>
                <a class="btn btn-ghost" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Profile" asp-action="Index"
                   asp-route-userName="@User.Identity!.Name">My Profile</a>
            }
            else
            {
                <hr />
                <a class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                   asp-controller="Auth" asp-action="Register">Sign up</a>
            }
        </div>
    </div>

    <main id="main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="page-shell">
            <span>PersonaNest — your home for everything you love.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        @* Phase 15: real-time notifications. Progressive enhancement only - the bell and
           /Notifications page above already work without this; it just makes updates arrive
           live instead of on next page load. *@
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
