@using Microsoft.AspNetCore.Identity
@using PersonaNest.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PersonaNest</title>
    <meta name="description" content="Your home for everything you love." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@@9..144,300;9..144,400;9..144,600;9..144,700&amp;family=Outfit:wght@@300;400;500;600;700&amp;family=JetBrains+Mono:wght@@400;500&amp;display=swap" rel="stylesheet" />

    @* Bootstrap 5 first, then site.css overrides it - design system "Bootstrap 5 + Custom CSS Strategy". *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="navbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <div class="navbar-brand-mark">P</div>PersonaNest
        </a>

        <div class="navbar-nav d-none d-lg-flex">
            <a class="navbar-link @(ViewData["Nav"] as string == "Home" ? "active" : null)"
               asp-controller="Home" asp-action="Index">Home</a>
            <a class="navbar-link @(ViewData["Nav"] as string == "Search" ? "active" : null)"
               asp-controller="Search" asp-action="Index">Search</a>
        </div>

        <div class="navbar-spacer"></div>

        @if (SignInManager.IsSignedIn(User))
        {
            <a class="btn btn-ghost btn-sm d-none d-md-inline-flex"
               asp-controller="Entries" asp-action="Index">My Entries</a>
            <a class="btn btn-ghost btn-sm d-none d-md-inline-flex"
               asp-controller="Profile" asp-action="Index"
               asp-route-userName="@User.Identity!.Name">My Profile</a>
            <a class="btn btn-ghost btn-sm d-none d-md-inline-flex"
               asp-controller="Settings" asp-action="Index">Settings</a>

            @* Sign out is a POST with an anti-forgery token - see the Phase 5 report. *@
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
            </form>

            <a class="navbar-avatar" asp-controller="Profile" asp-action="Index"
               asp-route-userName="@User.Identity!.Name" title="@User.Identity!.Name">
                @{
                    var currentUser = await UserManager.GetUserAsync(User);
                }
                @if (!string.IsNullOrEmpty(currentUser?.ProfilePictureUrl))
                {
                    <img src="@currentUser.ProfilePictureUrl" alt="Your avatar" />
                }
                else
                {
                    <span class="avatar-fallback">@(currentUser?.DisplayName?.FirstOrDefault() ?? 'U')</span>
                }
            </a>
        }
        else
        {
            <a class="btn btn-ghost btn-sm" asp-controller="Auth" asp-action="Login">Log in</a>
            <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Join Free</a>
        }
    </nav>

    <main id="main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="page-shell">
            <span>PersonaNest — your home for everything you love.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
