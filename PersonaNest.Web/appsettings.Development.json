{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }

  // Seed passwords are NOT stored here, and setting them is optional: if a Seed:*Password
  // secret isn't configured, DbSeeder generates one on first run and writes it to
  // PersonaNest.Web/dev-credentials.local.txt (gitignored). To set your own instead:
  //   dotnet user-secrets init      -p PersonaNest.Web
  //   dotnet user-secrets set "Seed:AdminPassword"     "<password>" -p PersonaNest.Web
  //   dotnet user-secrets set "Seed:ModeratorPassword" "<password>" -p PersonaNest.Web
  //   dotnet user-secrets set "Seed:UserPassword"      "<password>" -p PersonaNest.Web
}
